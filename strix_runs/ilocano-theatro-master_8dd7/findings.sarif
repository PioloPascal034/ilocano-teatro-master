        {
          "ruleId": "strix-coverage/privilege-boundary-bypass-through-elevated-sql-functions",
          "ruleIndex": 12,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Privilege boundary bypass through elevated SQL functions — No issue identified: All SECURITY DEFINER functions, triggers, EXECUTE grants, and table/column grants\n\nReviewed every SECURITY DEFINER declaration across bootstrap and migrations. Non-trigger RPCs bind access to `auth.uid()` through explicit authentication, role, ownership, editor, or assignment checks; trigger-only functions cannot be invoked as ordinary RPCs. Elevated functions set an empty search path and have explicit public/anon revokes; table grants are paired with RLS and sensitive columns such as `profiles.role` and `question_options.is_correct` are not client-writable/readable."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "All SECURITY DEFINER functions, triggers, EXECUTE grants, and table/column grants"
                }
