        },
        {
          "ruleId": "strix-coverage/vertical-privilege-escalation",
          "ruleIndex": 8,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Vertical privilege escalation — Ruled out: Profile role integrity and curriculum-editor authorization\n\n`handle_new_user` creates profiles with default `student` role and ignores user-supplied role metadata; authenticated profile UPDATE is column-limited and excludes `role`. `curriculum_editors` has no client table grants, while `is_curriculum_editor()` requires both an admin-provisioned row and a current `teacher` profile for `auth.uid()`."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Profile role integrity and curriculum-editor authorization"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Vertical privilege escalation",
              "surface": "Profile role integrity and curriculum-editor authorization",
              "recorded_by": "Repository Mapping Lead",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/unauthorized-relationship-creation-class-code-abuse",
          "ruleIndex": 9,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Unauthorized relationship creation / class-code abuse — Ruled out: Class join-code RPCs and teacher_students assignment\n\nCode creation/retrieval/revocation requires `is_teacher()`, redemption requires an authenticated student and a 128-bit random unexpired/unrevoked code hash, and a unique `student_id` index plus exception rollback enforces one teacher per student under concurrency. Direct client writes to both code and assignment tables are unavailable."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Class join-code RPCs and teacher_students assignment"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Unauthorized relationship creation / class-code abuse",
              "surface": "Class join-code RPCs and teacher_students assignment",
              "recorded_by": "Repository Mapping Lead",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/assessment-confidentiality-and-score-integrity",
          "ruleIndex": 10,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Assessment confidentiality and score integrity — Ruled out: Quiz questions/options, attempts/answers, and editor RPCs\n\nLearner reads cascade through `questions_read`/`options_read` to published-only `quizzes_read`; column grants deny `explanation` and `is_correct`. Direct attempt/answer writes are revoked, `submit_quiz` requires a student and published quiz/module, validates every question/option, and computes/stores scores server-side. Editor writes and answer-key/reorder RPCs require `is_curriculum_editor()`."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Quiz questions/options, attempts/answers, and editor RPCs"
                }
              ]
            }
          ],
          "properties": {
            "strix": {
              "coverage_outcome": "ruled_out",
              "risk_area": "Assessment confidentiality and score integrity",
              "surface": "Quiz questions/options, attempts/answers, and editor RPCs",
              "recorded_by": "Repository Mapping Lead",
              "source": "agent_reported"
            }
          }
        },
        {
          "ruleId": "strix-coverage/cross-student-idor-and-unauthorized-review-score-modification",
          "ruleIndex": 11,
          "kind": "pass",
          "level": "none",
          "message": {
            "text": "Cross-student IDOR and unauthorized review/score modification — Ruled out: Theme drafts, immutable submissions, reviews, and review_scores\n\nDraft ownership and teacher assignment are enforced by RLS and `can_review`; submissions and reviews are written only by `submit_theme`/`complete_review`, which check student ownership, teacher role, and assignment before writes. `scores_read` is constrained transitively by the referenced `reviews_read` RLS policy, so only the owning student or assigned teacher can resolve the required review row."
          },
          "locations": [
            {
              "logicalLocations": [
                {
                  "fullyQualifiedName": "Theme drafts, immutable submissions, reviews, and review_scores"
                }
              ]
            }
